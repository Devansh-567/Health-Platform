NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hms_db?schema=public

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

PASSWORD_RESET_TTL_MIN=30
PATIENT_TEMP_PASSWORD_TTL_HOURS=48
INVITATION_TTL_DAYS=3

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# --- Email -------------------------------------------------------------
# Leave MAIL_PROVIDER unset to auto-detect: SMTP_* present -> smtp,
# else RESEND_API_KEY present -> resend, else console (log-only, no send).
# MAIL_PROVIDER=smtp

# Option A — SMTP (recommended if you want to email ANY recipient, not just
# the address your Resend account was created with). Works with a real
# mailbox or relay:
#   - Gmail: smtp.gmail.com, port 587, an *app password* (not your login
#     password — https://myaccount.google.com/apppasswords)
#   - Your own domain's mailbox / a company SMTP relay
#   - Mailtrap / Amazon SES / SendGrid / Zoho SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASSWORD=your_smtp_password_or_app_password
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME="NCL-Hospital Management System"

# Option B — Resend (https://resend.com). Free tier, no domain verification
# needed when sending from onboarding@resend.dev, BUT that setup can only
# deliver to the email address you signed up to Resend with — verify your
# own domain on Resend to send to arbitrary recipients, or use SMTP above.
RESEND_API_KEY=xxxxxxxxxxxxxxxxxxxxxx
RESEND_SENDER_EMAIL=onboarding@resend.dev
RESEND_SENDER_NAME="NCL-Hospital Management System"

# --- MQTT (HiveMQ Cloud) --------------------------------------------------
# Used ONLY to publish the hospital emergency-alarm event server-side.
# Create a free cluster at https://console.hivemq.cloud, then Access
# Management -> create credentials, and copy the "Cluster URL" from Overview.
# The frontend connects to the SAME broker directly (browser MQTT-over-
# WebSocket) for live PPG vitals and to receive alarms — see
# frontend/.env.example for the matching VITE_MQTT_* vars. Leave unset and
# the app runs fine; alarms just won't be published (logged as a warning).
MQTT_URL=mqtts://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=your_hivemq_username
MQTT_PASSWORD=your_hivemq_password

COOKIE_DOMAIN=localhost
