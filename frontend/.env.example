# --- MQTT (HiveMQ Cloud) --------------------------------------------------
# The browser connects DIRECTLY to this broker over MQTT-over-WebSocket for:
#   - the paramedic's simulated PPG monitor publishing live vitals
#   - doctors/admins subscribing to live vitals for an assigned case
#   - hospital admins subscribing to the emergency-alarm topic
# Use the SAME cluster as the backend's MQTT_URL (backend/.env) — copy the
# "Web Client" connection details from your HiveMQ Cloud console
# (Access Management -> Overview -> Web Client tab shows the wss:// URL).
#
# NOTE: these credentials ship inside the frontend bundle, so anyone using
# the app can read them — acceptable for a demo/internal tool with a single
# shared broker, but for real production hardening you'd issue short-lived,
# per-client scoped credentials (HiveMQ Cloud supports JWT-based auth) rather
# than one shared username/password baked into the client.
VITE_MQTT_URL=wss://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_USERNAME=your_hivemq_username
VITE_MQTT_PASSWORD=your_hivemq_password
